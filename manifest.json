{
  "manifest_version": 3,
  "name": "FocusPulse",
  "version": "1.0",
  "description": "Privacy-First Adaptive Focus Assistant",
  "permissions": ["storage", "tabs", "notifications"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}